{
  "manifest_version": 3,
  "name": "LLM Assistant",
  "version": "1.0",
  "description": "Ask an LLM and get a response.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://api-inference.huggingface.co/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}
